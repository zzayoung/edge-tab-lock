{
  "manifest_version": 3,
  "name": "Edge Tab Lock",
  "description": "Bring back tab locking in Microsoft Edge. Protect selected tabs from Ctrl+W and middle-click.",
  "version": "0.2.4",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Connecting to Edge Tab Lock helper",
    "default_popup": "popup.html"
  }
}
